    <parent>
        <artifactId>find</artifactId>
        <groupId>com.hp.autonomy.frontend.find</groupId>
        <version>27.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>core</artifactId>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The only parts of node_modules needed at runtime (tested by StyleSheetServiceImplTest) -->
                        <id>unpack-runtime-libraries</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.hp.autonomy.frontend.find</groupId>
                                    <artifactId>frontend</artifactId>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                        <includes>
                                            <!-- imported by src/main/resources/less/ -->
                                            static/lib/bootstrap/less/**,
                                            static/lib/bootstrap-slider/dist/css/bootstrap-slider.css,
                                            static/lib/datatables.net-bs/css/dataTables.bootstrap.css,
                                            static/lib/datatables.net-fixedcolumns-bs/css/fixedColumns.bootstrap.css,
                                            static/lib/eonasdan-bootstrap-datetimepicker/src/less/**,
                                            static/lib/font-awesome/less/**,
                                            static/lib/hp-autonomy-about-page/src/css/**,
                                            static/lib/hp-autonomy-js-whatever/src/css/**,
                                            static/lib/hp-autonomy-settings-page/src/css/**,
                                            static/lib/leaflet/dist/leaflet.css,
                                            static/lib/leaflet-draw/dist/leaflet.draw.css,
                                            static/lib/leaflet.awesome-markers/dist/leaflet.awesome-markers.css,
                                            static/lib/leaflet.markercluster/dist/MarkerCluster.css,
                                            static/lib/leaflet.markercluster/dist/MarkerCluster.Default.css,
                                            static/lib/metismenu/dist/metisMenu.css,
                                            <!-- reached by url() in CSS -->
                                            static/lib/font-awesome/fonts/**,
                                            static/lib/leaflet/dist/images/**,
                                            static/lib/leaflet-draw/dist/images/**,
                                            static/lib/leaflet.awesome-markers/dist/images/**,
                                            <!-- linked from themetracker.html -->
                                            static/lib/bootstrap/dist/css/bootstrap.min.css,
                                            static/lib/bootstrap/dist/fonts/**,
                                            static/lib/open-sans-fontface/open-sans.css,
                                            static/lib/open-sans-fontface/fonts/**
                                        </includes>
                                    <!-- don't require `clean` to pull in a newer `frontend` build -->
                                    <overWrite>true</overWrite>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jar-frontend</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>frontend</classifier>
                            <classesDirectory>${basedir}/src/main/public</classesDirectory>
                            <includes>
                                <include>static/js/**</include>
                            </includes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/public</directory>
                <excludes>
                    <!-- included in the `classifier=frontend` jar instead -->
                    <exclude>static/js/**</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

