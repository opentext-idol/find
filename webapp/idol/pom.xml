        <version>26.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>idol</artifactId>

    <packaging>war</packaging>

    <properties>
        <artifactName>${project.parent.artifactId}</artifactName>

        <frontend.docker.content.skip>false</frontend.docker.content.skip>
        <frontend.docker.view.skip>false</frontend.docker.view.skip>
        <frontend.docker.answerserver.skip>false</frontend.docker.answerserver.skip>
        <frontend.docker.community.skip>false</frontend.docker.community.skip>
        <frontend.docker.agentstore.skip>false</frontend.docker.agentstore.skip>
        <frontend.docker.answerbankAgentstore.skip>false</frontend.docker.answerbankAgentstore.skip>

        <!-- Terser is the bulk of webpack's cost; default to the much faster development
             mode for everyday `mvn install`, and pass -Dwebpack.mode=production for a real,
             minified deployable build. -->
        <webpack.mode>development</webpack.mode>
        <skip.webpack>false</skip.webpack>
    </properties>

    <build>
        <finalName>${artifactName}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.fabric8</groupId>
                <artifactId>docker-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>npm-install</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>npm</executable>
                            <workingDirectory>${basedir}</workingDirectory>
                            <arguments>
                                <argument>ci</argument>
                                <argument>--no-audit</argument>
                                <argument>--allow-git=all</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jasmine</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/node_modules/.bin/grunt${npm.binExtension}</executable>
                            <workingDirectory>${basedir}</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                            </arguments>
                            <successCodes>
                                <successCode>3</successCode>
                            </successCodes>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <!--
                        webpack must always run here, not just under some "production" mode:
                        under a bundler there is no unbundled mode the browser can consume, so
                        skipping it would leave a white screen. Kept at phase `compile` (not
                        e.g. prepare-package) because `spring-boot:run` is
                        @Execute(phase = "test-compile") and so forks through `compile` -
                        binding later would break `mvn spring-boot:run`. Defaults to the much
                        faster development mode; pass -Dwebpack.mode=production for a minified
                        build, or -Dskip.webpack=true to skip entirely.
                    -->
                    <execution>
                        <id>webpack-build</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/node_modules/.bin/webpack${npm.binExtension}</executable>
                            <workingDirectory>${basedir}</workingDirectory>
                            <arguments>
                                <argument>--mode</argument>
                                <argument>${webpack.mode}</argument>
                            </arguments>
                            <skip>${skip.webpack}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeArtifactIds>core</includeArtifactIds>
                            <includeTypes>jar</includeTypes>
                            <includeClassifiers>full</includeClassifiers>
                            <includes>static/**/*</includes>
                            <outputDirectory>${static-resources-dir}</outputDirectory>
                            <overWriteIfNewer>false</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <overwrite>true</overwrite>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <finalName>${artifactName}</finalName>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/public</directory>
            </resource>
        </resources>
    </build>

